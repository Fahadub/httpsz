# ---------------- App ----------------
APP_NAME="Udeyou OTP"
APP_URL=https://udeyou.com
APP_ENV=production
# 64 random hex chars. Generate with:  php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=CHANGE_ME
# The account registered with this email becomes the platform admin
ADMIN_EMAIL=you@udeyou.com
REGISTRATION_OPEN=true
SIGNUP_BONUS_CREDITS=10
SESSION_SECURE_COOKIE=true

# ---------------- Database (hPanel > Databases > MySQL) ----------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_otp
DB_USER=u123456789_otp
DB_PASS=CHANGE_ME

# ---------------- Mail (hPanel > Emails) ----------------
# smtp = real sending | log = write emails to storage/logs/mail.log (local testing)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
# ssl (port 465) or tls (port 587)
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@udeyou.com
MAIL_PASSWORD=CHANGE_ME
# Must be the same mailbox (or an alias of it) for SPF/DKIM to pass
MAIL_FROM_ADDRESS=no-reply@udeyou.com
MAIL_TIMEOUT=15

# ---------------- OTP rules ----------------
OTP_LENGTH=6
# seconds (300 = 5 minutes)
OTP_TTL=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_PER_RECIPIENT_HOUR=5
RATE_LIMIT_PER_MINUTE=60
